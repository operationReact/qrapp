{
  "info": {
    "name": "qrapp - Analytics & Combos",
    "_postman_id": "c5d6e7f8-qrapp-analytics-combos",
    "description": "Postman collection for Analytics and Combo controller endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "var user = pm.environment.get('adminUsername') || '';",
          "var pass = pm.environment.get('adminPassword') || '';",
          "if (user && pass) {",
          "    try { pm.environment.set('adminAuth', btoa(user + ':' + pass)); }",
          "    catch (e) { pm.environment.set('adminAuth', Buffer.from(user + ':' + pass).toString('base64')); }",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "password", "type": "string" },
    { "key": "fromDate", "value": "2026-04-25", "type": "string" },
    { "key": "toDate", "value": "2026-05-25", "type": "string" }
  ],
  "item": [
    {
      "name": "Analytics — Sales",
      "item": [
        {
          "name": "Daily Sales Time-Series",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Basic {{adminAuth}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/sales/daily?from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "sales", "daily"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Daily Sales Time-Series (Paged)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Basic {{adminAuth}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/sales/daily/paged?from={{fromDate}}&to={{toDate}}&page=0&size=30&sort=salesDate,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "sales", "daily", "paged"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "30" },
                { "key": "sort", "value": "salesDate,desc" }
              ]
            }
          },
          "response": []
        },
        {
