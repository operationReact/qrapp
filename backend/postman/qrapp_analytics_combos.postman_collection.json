    {
      "name": "Combos (Admin)",
      "item": [
        {
          "name": "Create Combo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminAuth}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Family Feast Combo\",\n  \"description\": \"Serves 4 — includes mains, sides and dessert\",\n  \"comboPrice\": 799,\n  \"categoryId\": 1,\n  \"isActive\": true,\n  \"isFeatured\": false,\n  \"isPreorder\": false,\n  \"displayPriority\": 1,\n  \"timeSlot\": \"FULL_DAY\",\n  \"items\": [\n    { \"menuItemId\": 1, \"quantity\": 2 },\n    { \"menuItemId\": 3, \"quantity\": 1 }\n  ],\n  \"schedules\": [\n    { \"dayOfWeek\": \"MONDAY\", \"startTime\": \"10:00\", \"endTime\": \"22:00\" },\n    { \"dayOfWeek\": \"FRIDAY\", \"startTime\": \"10:00\", \"endTime\": \"23:00\" }\n  ],\n  \"signatureProductIds\": [1, 3]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/combos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "combos"]
            }
          },
          "response": []
        },
        {
          "name": "List Combos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Basic {{adminAuth}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/combos?page=0&size=20&sort=displayPriority",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "combos"],
              "query": [
                { "key": "search", "value": "feast", "disabled": true },
                { "key": "categoryId", "value": "1", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true },
                { "key": "isFeatured", "value": "false", "disabled": true },
                { "key": "isPreorder", "value": "false", "disabled": true },
                { "key": "timeSlot", "value": "FULL_DAY", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "displayPriority" }
              ]
            },
            "description": "timeSlot options: BREAKFAST | LUNCH | EVENING | FULL_DAY | CUSTOM"
          },
          "response": []
        },
