              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Family Feast Combo — Updated\",\n  \"description\": \"Serves 4 — updated description\",\n  \"comboPrice\": 849,\n  \"categoryId\": 1,\n  \"isActive\": true,\n  \"isFeatured\": true,\n  \"isPreorder\": false,\n  \"displayPriority\": 1,\n  \"timeSlot\": \"FULL_DAY\",\n  \"items\": [\n    { \"menuItemId\": 1, \"quantity\": 2 },\n    { \"menuItemId\": 3, \"quantity\": 1 },\n    { \"menuItemId\": 5, \"quantity\": 1 }\n  ],\n  \"schedules\": [\n    { \"dayOfWeek\": \"MONDAY\", \"startTime\": \"11:00\", \"endTime\": \"22:00\" }\n  ],\n  \"signatureProductIds\": [1]\n}",
