# Copy to keystore.properties and fill in values. Keep the real file untracked (see root .gitignore).
# storeFile is relative to the android/ directory, or an absolute path.
storeFile=C:/Users/you/.brobro-keys/brobro-upload-key.jks
storePassword=CHANGE_ME
keyAlias=brobro-upload
keyPassword=CHANGE_ME
