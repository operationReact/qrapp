{
  "appId": "in.broandbro.app",
  "appName": "BRO & BRO",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "iosScheme": "https",
    "allowNavigation": [
      "www.broandbro.in",
      "broandbro.in",
      "accounts.google.com",
      "appleid.apple.com",
      "*.razorpay.com"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
