# ============================================================
# Module: ec2
# Spring Boot backend on ARM64 Amazon Linux 2023.
# SSH key pair is AUTO-GENERATED by Terraform using the tls
# provider. The private key is stored in AWS SSM Parameter
# Store (SecureString) so CI/CD can fetch it without any
# manual secret management.
# ============================================================

terraform {
  required_providers {
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.0"
    }
  }
}

# ── Auto-generate SSH key pair ────────────────────────────────────────────────
# No manual key generation needed – Terraform handles this.
resource "tls_private_key" "this" {
  algorithm = "ED25519"
}

# ── Register the public key as an EC2 Key Pair ───────────────────────────────
resource "aws_key_pair" "this" {
  key_name   = "broandbro-${var.environment}-key"
  public_key = tls_private_key.this.public_key_openssh

  tags = {
    Name        = "broandbro-${var.environment}-key"
    Environment = var.environment
  }
}

# ── Store private key in SSM Parameter Store (SecureString) ──────────────────
# The backend deploy workflow reads from here – no GitHub secret needed.
resource "aws_ssm_parameter" "ssh_private_key" {
  name        = "/broandbro/${var.environment}/ec2-ssh-private-key"
  description = "EC2 SSH private key for ${var.environment} backend"
  type        = "SecureString"
  value       = tls_private_key.this.private_key_openssh

  tags = {
    Name        = "broandbro-${var.environment}-ssh-key"
    Environment = var.environment
  }

  lifecycle {
    # Never overwrite an existing key – prevents locking yourself out
    ignore_changes = [value]
  }
}

# Latest Amazon Linux 2023 AMI for ARM64 (Graviton) in us-east-1
data "aws_ami" "al2023_arm" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-arm64"]
  }

  filter {
    name   = "architecture"
    values = ["arm64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ── IAM Role for EC2 ──────────────────────────────────────────────────────────
resource "aws_iam_role" "ec2" {
  name = "broandbro-${var.environment}-ec2-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })

  tags = {
    Name        = "broandbro-${var.environment}-ec2-role"
    Environment = var.environment
  }
}

resource "aws_iam_role_policy_attachment" "ssm" {
  role       = aws_iam_role.ec2.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_role_policy_attachment" "cloudwatch" {
  role       = aws_iam_role.ec2.name
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
}

# Allow EC2 to read its own SSM parameters (needed for CloudWatch agent config)
resource "aws_iam_role_policy" "ssm_read" {
  name = "broandbro-${var.environment}-ssm-read"
  role = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["ssm:GetParameter", "ssm:GetParameters"]
      Resource = [
        "arn:aws:ssm:*:*:parameter/broandbro/${var.environment}/*",
        "arn:aws:ssm:*:*:parameter/broandbro/backend/${var.environment}/*"
      ]
    }]
  })
}

# ── S3 media bucket access (AI-generated images + deploy artifacts) ───────────
# Only attached when media_bucket_arn is provided (non-empty).
resource "aws_iam_role_policy" "media_s3" {
  count = var.create_media_s3_policy ? 1 : 0
  name  = "broandbro-${var.environment}-media-s3"
  role  = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowLocationMenuImageUploads"
        Effect = "Allow"
        Action = [
          "s3:PutObject",
          "s3:GetObject",
          "s3:DeleteObject"
        ]
        Resource = [
          "${var.media_bucket_arn}/locations/menu-images/*",
          "${var.media_bucket_arn}/hall-of-happiness/*",
          "${var.media_bucket_arn}/menu-items/*",
          "${var.media_bucket_arn}/campaigns/*",
          "${var.media_bucket_arn}/categories/*",
          "${var.media_bucket_arn}/products/*"
        ]
      },
      {
        # EC2 pulls its own deploy JAR from S3 instead of receiving it via SCP.
        # Scoped to this environment's prefix so dev cannot read prod artifacts.
        Sid    = "AllowDeployArtifactDownload"
        Effect = "Allow"
        Action = ["s3:GetObject"]
        Resource = "${var.media_bucket_arn}/deploy/${var.environment}/*"
      },
      {
        Sid    = "AllowBucketList"
        Effect = "Allow"
        Action = ["s3:ListBucket"]
        Resource = var.media_bucket_arn
        Condition = {
          StringLike = {
            "s3:prefix" = ["locations/menu-images/*", "hall-of-happiness/*", "menu-items/*", "campaigns/*", "categories/*", "products/*", "deploy/${var.environment}/*"]
          }
        }
      }
    ]
  })
}

resource "aws_iam_instance_profile" "ec2" {
  name = "broandbro-${var.environment}-ec2-profile"
  role = aws_iam_role.ec2.name
}

# ── EC2 Instance ──────────────────────────────────────────────────────────────
resource "aws_instance" "this" {
  ami                    = data.aws_ami.al2023_arm.id
  instance_type          = var.instance_type
  key_name               = aws_key_pair.this.key_name
  vpc_security_group_ids = [var.security_group_id]
  iam_instance_profile   = aws_iam_instance_profile.ec2.name

  user_data = base64encode(templatefile("${path.module}/userdata.sh", {
    environment = var.environment
  }))

  root_block_device {
    volume_type           = "gp3"
    volume_size           = var.root_volume_size
    encrypted             = true
    delete_on_termination = true
  }

  monitoring = var.environment == "prod"

  tags = {
    Name        = "broandbro-${var.environment}-backend"
    Environment = var.environment
  }

  lifecycle {
    ignore_changes = [ami, user_data]
  }
}

# ── Elastic IP ────────────────────────────────────────────────────────────────
resource "aws_eip" "this" {
  instance = aws_instance.this.id
  domain   = "vpc"

  tags = {
    Name        = "broandbro-${var.environment}-eip"
    Environment = var.environment
  }
}

# ── Store Elastic IP in SSM so the deploy workflow can read it ────────────────
resource "aws_ssm_parameter" "ec2_ip" {
  name        = "/broandbro/${var.environment}/ec2-public-ip"
  description = "EC2 Elastic IP for ${var.environment} backend – used by deploy workflow"
  type        = "String"
  value       = aws_eip.this.public_ip

  tags = {
    Name        = "broandbro-${var.environment}-ec2-ip"
    Environment = var.environment
  }
}

# ── Ensure SSM Agent is installed and running ─────────────────────────────────
# This fixes existing instances where the agent may have stopped or not been
# installed. Runs via SSH on every `terraform apply` (trigger = instance ID).
resource "null_resource" "ensure_ssm_agent" {
  triggers = {
    instance_id = aws_instance.this.id
  }

  connection {
    type        = "ssh"
    user        = "ec2-user"
    private_key = aws_ssm_parameter.ssh_private_key.value
    host        = aws_eip.this.public_ip
    timeout     = "5m"
  }

  provisioner "remote-exec" {
    inline = [
      "echo '=== Ensuring SSM Agent is installed and active ==='",
      # Try dnf first (works on AL2023 when package repo has it)
      "sudo dnf install -y amazon-ssm-agent 2>/dev/null || true",
      # If dnf didn't install it, fall back to direct RPM (AL2023 ARM64 / Graviton)
      "sudo systemctl is-enabled amazon-ssm-agent >/dev/null 2>&1 || sudo rpm --import https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_arm64/amazon-ssm-agent.rpm 2>/dev/null || sudo dnf install -y 'https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_arm64/amazon-ssm-agent.rpm'",
      "sudo systemctl enable amazon-ssm-agent",
      "sudo systemctl restart amazon-ssm-agent",
      "sleep 5",
      "sudo systemctl is-active amazon-ssm-agent && echo 'SSM Agent is ACTIVE' || echo 'WARNING: SSM Agent failed to start'",
    ]
  }

  depends_on = [aws_eip.this]
}
