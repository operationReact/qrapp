# ─────────────────────────────────────────────────────────────────────────────
# broandbro DEV environment variables
# Copy to terraform.tfvars and fill in values if needed.
# NEVER commit terraform.tfvars to version control.
#
# NOTE: Most sensitive values (DB password, SSH keys) are AUTO-GENERATED
# by Terraform and stored in AWS SSM Parameter Store.
# ─────────────────────────────────────────────────────────────────────────────

aws_region  = "ap-south-1"
domain_name = "broandbro.in"

# Frontend S3 bucket
frontend_bucket_name = "" # Account-scoped name generated by Terraform

# EC2 Backend
ec2_instance_type = "t4g.micro"

# SSH access (dev: open for convenience, tighten in prod)
ssh_allowed_cidrs = [] # SSM only; no SSH inbound

# RDS PostgreSQL
rds_instance_class = "db.t4g.micro"
db_name            = "broandbro_dev"
db_username        = "broandbro"
# db_password is auto-generated by Terraform (no need to set manually)

# CloudWatch – optional email for alarm notifications
alarm_email = ""

# ── Media bucket ──────────────────────────────────────────────────────────────
# Development media bucket for AI-generated menu images
media_bucket_name = "" # Account-scoped name generated by Terraform


# REQUIRED: supply via TF_VAR_expected_account_id (never use the old AWS account)
